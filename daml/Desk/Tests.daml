testAccrueIdempotentOnLedger : Script ()
testAccrueIdempotentOnLedger = script do
  p <- allocateFixture
  now <- getTime
  let terms = sampleTerms now
      policy = productionAuth
  (readyCid, usdcCid, lenderAuthD, borrowerAuthD, _) <-
    originateReady p terms policy 2.0
  loanCid <- disburseLoan p readyCid usdcCid (Some lenderAuthD) (Some borrowerAuthD)
  passTime (days 30)
  loan1 <- submit p.creditOfficer do exerciseCmd loanCid Accrue
  debt1 <- submit p.creditOfficer do exerciseCmd loan1 PeekDebt
  -- Accrue again at same ledger time → interest unchanged
  loan2 <- submit p.creditOfficer do exerciseCmd loan1 Accrue
  debt2 <- submit p.creditOfficer do exerciseCmd loan2 PeekDebt
  assertMsg "accrue idempotent per time" $
    debt1.accruedInterest == debt2.accruedInterest
  pure ()

testCustodyInvariantAfterLock : Script ()
testCustodyInvariantAfterLock = script do
  p <- allocateFixture
  now <- getTime
  let terms = sampleTerms now
      policy = productionAuth
  (readyCid, usdcCid, lenderAuthD, borrowerAuthD, _) <-
    originateReady p terms policy 2.0
  -- Peek vault via Disburse path assertions; also exercise AssertCustodyInvariant
  ready <- queryContractId p.creditOfficer readyCid
  case ready of
    None -> abort "ready missing"
    Some r -> do
      _ <- submit p.creditOfficer do
        exerciseCmd r.vaultCid AssertCustodyInvariant
      _ <- submit p.creditOfficer do
        exerciseCmd r.claimCid AssertClaimMatchesVault
      loanCid <- disburseLoan p readyCid usdcCid (Some lenderAuthD) (Some borrowerAuthD)
      loan <- queryContractId p.creditOfficer loanCid
      case loan of
        None -> abort "loan missing"
        Some l -> do
          _ <- submit p.creditOfficer do
            exerciseCmd l.vaultCid AssertCustodyInvariant
          pure ()

-- ---------------------------------------------------------------------------
-- Fast path vs DecMan-gated custody (Point 6)
-- ---------------------------------------------------------------------------

-- | GATED PATH: RequestGovernedCustodyRelease fails without DecMan evidence (do not fake).
testGovernedCustodyReleaseRequiresDecMan : Script ()
testGovernedCustodyReleaseRequiresDecMan = script do
  p <- allocateFixture
  now <- getTime
  let terms = sampleTerms now
      policy = productionAuth
  (readyCid, usdcCid, lenderAuthD, borrowerAuthD, _) <-
    originateReady p terms policy 2.0
  loanCid <- disburseLoan p readyCid usdcCid (Some lenderAuthD) (Some borrowerAuthD)
  loan <- queryContractId p.creditOfficer loanCid
  case loan of
    None -> abort "loan missing"
    Some l -> do
      -- Missing evidence → abort (gated path not live)
      submitMustFail (actAs [p.creditOfficer, p.lender]) do
        exerciseCmd l.vaultCid RequestGovernedCustodyRelease with
          kind = "release-to-borrower"
          txConfirmationEvidence = None
          topologyEvidence = None
          appGovernanceEvidence = None
      -- Scaffold-looking evidence still fails — settlement not wired (do not fake DecMan)
      submitMustFail (actAs [p.creditOfficer, p.lender]) do
        exerciseCmd l.vaultCid RequestGovernedCustodyRelease with
          kind = "admin-seize"
          txConfirmationEvidence = Some "scaffold-not-live"
          topologyEvidence = None
          appGovernanceEvidence = None
      -- Loan still alive after gated-path refusals
      still <- queryContractId p.creditOfficer loanCid
      assertMsg "loan remains after gated refusals" $ still /= None
      pure ()

-- | Document: Liquidate alias still exercises the same FAST PATH as LiquidateFast.
testLiquidateAliasFastPath : Script ()
testLiquidateAliasFastPath = script do
  p <- allocateFixture
  now <- getTime
  let terms = liqTerms now
      policy = productionAuth
  (readyCid, usdcCid, lenderAuthD, borrowerAuthD, _) <-
    originateReady p terms policy 1.0
  loanCid <- disburseLoan p readyCid usdcCid (Some lenderAuthD) (Some borrowerAuthD)
  liquidatorAuth <- grantAuth p.creditOfficer p.grofty p.liquidator LiquidatorRole purposeLiquidate
  loanCid2 <- submit p.creditOfficer do
    exerciseCmd loanCid UpdateMarkPrice with newPrice = 90_000.0
  _ <- submit (actAs [p.liquidator, p.creditOfficer]) do
    exerciseCmd loanCid2 Liquidate with liquidatorAuthCid = Some liquidatorAuth
  pure ()
