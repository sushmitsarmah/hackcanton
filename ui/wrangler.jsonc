{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cbtc-collateral-desk",
  "compatibility_date": "2026-10-06",
  "main": "./worker/index.ts",
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
