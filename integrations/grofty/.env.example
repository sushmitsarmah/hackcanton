# Grofty / CIP-103 integration for CBTC Collateral Desk
# Copy to .env (do not commit secrets). Default mode is mock.

# mock = offline production-shaped client (CI / LocalNet / Node prove script)
# live = @canton-network/dapp-sdk + Grofty browser extension (requires whitelist)
GROFTY_MODE=mock

# Optional CIP-103 remote wallet gateway (MainNet-oriented fallback when extension absent)
# GROFTY_REMOTE_GATEWAY_RPC_URL=https://YOUR_GATEWAY/api/json-rpc

# Preferred Grofty extension provider id (CIP-103 / EIP-6963-style)
# Default matches official extension id from grofty.cc/docs/installation
# GROFTY_PREFERRED_PROVIDER_ID=browser:ext:ojlgdkgfbpkjceancgnniegbgadgmhig

# Mock authority party (LocalNet stand-in for Grofty auth oracle)
# GROFTY_MOCK_AUTHORITY_PARTY=GroftyAuth::1220...

# Desk.Auth module template prefix (package name from daml.yaml)
# GROFTY_AUTH_MODULE_ID=#cbtc-collateral-desk:Desk.Auth
